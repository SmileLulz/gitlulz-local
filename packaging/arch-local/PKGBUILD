# Maintainer: SmileLulz <SmileLulz@users.noreply.github.com>
# Local PKGBUILD: builds from the current project working tree

_pkgbuild_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
_project_root="$(realpath "$_pkgbuild_dir/../..")"

pkgname=gitlulz-local
if git -C "$_project_root" describe --tags --dirty >/dev/null 2>&1; then
    pkgver="$(git -C "$_project_root" describe --tags --dirty | sed -e 's/^v//' -e 's/-/./g')"
else
    _count="$(git -C "$_project_root" rev-list --count HEAD 2>/dev/null || echo 0)"
    _hash="$(git -C "$_project_root" rev-parse --short=7 HEAD 2>/dev/null || echo unknown)"
    pkgver="0.0.0.r${_count}.g${_hash}"
fi
pkgrel=1

pkgdesc="Polished local Git hosting: remote setup and verified backups"
url="https://github.com/SmileLulz/gitlulz-local"
arch=('x86_64' 'aarch64' 'armv7h' 'riscv64')
options=(!lto)
license=('MIT')
depends=('git')
makedepends=('go' 'git')

source=()
sha256sums=()

prepare() {
    local build_root="$srcdir/$pkgname"
    local item

    if [[ ! -f "$_project_root/go.mod" ]]; then
        printf 'Error: go.mod not found in %s\n' "$_project_root" >&2
        return 1
    fi

    rm -rf -- "$build_root"
    mkdir -p "$build_root"

    for item in go.mod go.sum src README.md LICENSE; do
        if [[ -e "$_project_root/$item" ]]; then
            cp -a "$_project_root/$item" "$build_root/"
        fi
    done

    cd "$build_root"
    export GOTOOLCHAIN=local
    [[ -f go.sum ]] || go mod tidy
    go mod download
}

build() {
    cd "$srcdir/$pkgname"
    export GOTOOLCHAIN=local
    export CGO_ENABLED=0

    go build -trimpath -buildvcs=false \
        -ldflags "-s -w -X main.version=$pkgver" \
        -o gitlulz-local ./src

    mkdir -p dist/man
    ./gitlulz-local man dist/man
}

check() {
    cd "$srcdir/$pkgname"
    export GOTOOLCHAIN=local
    export CGO_ENABLED=0
    go test ./...
}

package() {
    cd "$srcdir/$pkgname"
    install -Dm755 gitlulz-local "$pkgdir/usr/bin/gitlulz-local"
    if compgen -G "dist/man/*.1" >/dev/null; then
        install -Dm644 -t "$pkgdir/usr/share/man/man1" dist/man/*.1
    fi
    [[ -f LICENSE   ]] && install -Dm644 LICENSE   "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    [[ -f README.md ]] && install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
